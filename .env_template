SECRET_KEY= # Здесь должен находиться ваш секретный Django-ключ

DEBUG= # Флаг для запуска проекта в режиме разработки, НЕ УКАЗЫВАТЬ ДЛЯ ПРОДАКШЕНА!!!

CURRENT_SITE= # адрес проекта в глобальной сети, по умолчанию устанавливается http://localhost:8000

# Параметры подключения к базе данных
DB_NAME= # Название БД
DB_USER= # Имя пользователя БД
DB_PASSWORD= # Пароль пользователя БД
DB_PORT= # Порт подключения БД, УКАЗЫВАТЬ ДЛЯ ПРОДАКШЕНА НЕ ЖЕЛАТЕЛЬНО!!!
    # Переменная может быть использована для доступа к базе данных docker-контейнера в обход основного интерфейса приложения

# Параметры токенов авторизации
ACCESS_TOKEN_LIFETIME= # Срок годности access-токена в минутах, по умолчанию устанавливается 5
REFRESH_TOKEN_LIFETIME= # Срок годности refresh-токена в сутках, по умолчанию устанавливается 1

# Параметры подключения к SMTP-серверу
EMAIL_HOST= # Адрес SMTP-сервера
EMAIL_PORT= # Порт для TLS-соединения, по умолчанию используется 587
EMAIL_USE_TLS= # Использование TLS-протокола шифрования, по умолчанию используется True
EMAIL_USE_SSL= # Использование SSL-протокола шифрования, по умолчанию используется False
EMAIL_HOST_USER= # Ваш email, должен соответствовать значению EMAIL_HOST
EMAIL_HOST_PASSWORD= # Пароль приложения

# Параметры соединения с api телеграм
TG_BOT_LINK= # Ссылка на бота приложения, зарегистрированного в api telegram, ОБЯЗАТЕЛЬНО ДЛЯ ПРОДАКШЕНА!!!
TG_BOT_ACCESS= # Ключ доступа бота, ОБЯЗАТЕЛЬНО ДЛЯ ПРОДАКШЕНА!!!
USE_TELEGRAM_INTEGRATION= # Флаг взаимодействия с api телеграм, по умолчанию используется True, УКАЗЫВАТЬ ДЛЯ ПРОДАКШЕНА НЕ ЖЕЛАТЕЛЬНО!!!
USE_TEST_WEBHOOK= # Флаг использования стороннего ресурса для получения телеграм-сообщений от пользователей в режиме разработки
TEST_WEBHOOK_PATH= # Временный url сервера, предоставляющего ссылку для тестирования вебхука

# Параметры часового пояса, в котором расположен сервер
LOCAL_TIME_ZONE= # Название местного часового пояса, например: Europe/Moscow. По умолчанию используется America/Chicago

# Параметры Redis
REDIS_HOST= # Хост подключения к брокеру Redis, НЕ УКАЗЫВАТЬ ДЛЯ ПРОДАКШЕНА!!!
REDIS_PORT= # Порт подключения к брокеру Redis, НЕ УКАЗЫВАТЬ ДЛЯ ПРОДАКШЕНА!!!
CACHE_DB= # Номер базы данных Redis для кеширования, НЕ УКАЗЫВАТЬ ДЛЯ ПРОДАКШЕНА!!!

# Настройки Celery
CELERY_BROKER_DB= # Номер базы данных Redis для воркера Celery, по умолчанию используется 2
CELERY_RESULT_DB= # Номер базы данных Redis для хранения результатов работы Celery, по умолчанию используется 3
CELERY_TASK_TRACK_STARTED= # Флаг отслеживания выполнения задач, по умолчанию используется true
CELERY_TASK_TIME_LIMIT= # Предел времени для обработки одной задачи в секундах, по умолчанию используется 63
    # минимально-допустимое значение для CELERY_TASK_TIME_LIMIT - 61 секунда, не рекомендуется устанавливать
    # большое значение при небольшом количестве запросов к базе  данных в единицу времени,
    # по мере роста нагрузки на базу данных может потребоваться постепенное увеличение данного параметра
CELERY_LOG_LEVEL= # Уровень логирования Celery, по умолчанию используется INFO
    # Доступные варианты уровня логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Тестирование
TEST_MODE= # Флаг для установки фиксированных настроек docker-сети внутри контейнера в тестовом режиме
    # По умолчанию имеет значение False, устанавливается автоматически при запуске github workflows, НЕ УКАЗЫВАТЬ ДЛЯ ПРОДАКШЕНА!!!

# Безопасность
CORS_ALLOWED_ORIGINS= # Указать список разрешенных доменов через запятую, без пробелов
CSRF_TRUSTED_ORIGINS= # Указать список разрешенных доменов через запятую, без пробелов
    # Пример значений для обоих ключей:
    # http://12.34.56.78,https://12.34.56.78,http://localhost,https://example.com